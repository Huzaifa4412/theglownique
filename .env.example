# Copy to .env.local for local dev, and set the same value in the Vercel
# project settings (Settings → Environment Variables) for production.

# WhatsApp number that receives quote requests.
# Digits only, full international format — no "+", spaces or dashes.
# Example: 447700900123 (UK), 923001234567 (PK), 15551234567 (US)
# Quote CTAs are disabled while this is unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Meta (Facebook/Instagram) Pixel ID, from Events Manager -> Data Sources.
#
# Optional, and note what each state does:
#   unset (this line absent)  -> falls back to the live production pixel
#   set to an id              -> uses that pixel, e.g. a test pixel on staging
#   present but left blank    -> pixel and all events switched OFF
#
# So leaving the line below blank in a copied .env.local is a valid way to keep
# local development out of the production pixel, but it is opt-in, not a default:
# a Vercel preview deploy with no override still reports to the live pixel.
NEXT_PUBLIC_META_PIXEL_ID=

# Sanity write token, used ONLY by the /api/leads route handler to archive
# submitted enquiries as `lead` documents.
#
# NOTE the missing NEXT_PUBLIC_ prefix, and keep it that way. This is a real
# credential: it can create, edit and delete every document in the dataset, so it
# must never reach the browser bundle. Create one at
# sanity.io/manage -> API -> Tokens with "Editor" permission.
#
# Unset is a valid state: the contact and chat forms still work and still reach
# WhatsApp, the enquiry just is not archived (the route logs a warning and
# returns 202).
SANITY_API_WRITE_TOKEN=
